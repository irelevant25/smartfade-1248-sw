# Extracted third-party binaries (proprietary, regenerate with tools/source-audit)
analysis/extracted/

# Raw USBPcap captures include every device on the root hub (keyboard/mouse reports). Only the console-only split is committed.
docs/protocol/captures/*.raw-all-devices.pcap

# Owner's show files from the console SD card (private; hashes of the files used as evidence are in the experiment records)
smartfade-sd-card-backup/

# .NET build output
bin/
obj/
*.user
.vs/
TestResults/

# Angular
node_modules/
dist/
.angular/

# Transfer logs of read-only USB sessions started from the repository root (the default is outside the repository)
/captures/
__pycache__/

# raw USBPcap captures and operator action logs land in the repository root during a session; only
# the console-only split and the dated copies under docs/protocol/captures/ are committed
/*.pcap
/*.pcapng
/*-actions.txt
